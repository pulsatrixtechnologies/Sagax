# The launcher bar of the Sagax server environment desktop
# (deploy/sandbox/sagax-desktop starts it): Chromium, Terminal and Files,
# the open windows and a clock, at the bottom of the screen.
rounded = 8
border_width = 0
background_color = #0f172a 85
border_color = #ffffff 0

rounded = 6
border_width = 0
background_color = #ffffff 14
border_color = #ffffff 0

panel_items = LTC
panel_size = 100% 44
panel_margin = 0 0
panel_padding = 8 4 8
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
wm_menu = 1
panel_dock = 0
strut_policy = follow_size
autohide = 0

launcher_padding = 4 4 8
launcher_background_id = 0
launcher_icon_size = 30
launcher_icon_theme = Adwaita
launcher_tooltip = 1
launcher_item_app = /usr/share/sagax/applications/sagax-browser.desktop
launcher_item_app = /usr/share/sagax/applications/sagax-terminal.desktop
launcher_item_app = /usr/share/sagax/applications/sagax-files.desktop

taskbar_mode = single_desktop
taskbar_padding = 6 2 6
taskbar_background_id = 0
taskbar_active_background_id = 0
taskbar_name = 0
task_icon = 1
task_text = 1
task_centered = 0
task_maximum_size = 220 32
task_padding = 6 4 6
task_font = DejaVu Sans 9
task_font_color = #e2e8f0 100
task_background_id = 0
task_active_background_id = 2
task_active_font_color = #ffffff 100
mouse_left = toggle_iconify

time1_format = %H:%M
time1_font = DejaVu Sans 10
clock_font_color = #e2e8f0 100
clock_padding = 8 0
clock_background_id = 0

tooltip_show_timeout = 0.4
tooltip_hide_timeout = 0.1
tooltip_padding = 6 4
tooltip_background_id = 1
tooltip_font = DejaVu Sans 9
tooltip_font_color = #e2e8f0 100
