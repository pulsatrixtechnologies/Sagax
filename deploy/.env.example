# Public hostname for automatic HTTPS (must resolve to this machine).
# Pairing links (`docker compose exec omb node dist-server/pair-cli.js`) point here.
DOMAIN=maus.example.com

# Engine CLIs baked into the image at build time. The image default is the
# full set (ENGINE_SET=all). Leave ENGINES empty: a non-empty value replaces
# the lock's npm engines, and the production gate then fails the build.
# A public image with no CLIs is ENGINE_SET=none and SAGAX_REQUIRE_ENGINES=0.
ENGINES=
ENGINE_SET=all
SAGAX_REQUIRE_ENGINES=1

# Optional: let people sign in with an emailed code instead of a pairing
# code. Addresses or @domain entries, comma-separated. Admins get full
# access; members get chat and approvals only.
OMB_SIGNIN_EMAILS=
OMB_SIGNIN_MEMBER_EMAILS=

# Mail for sign-in codes and invitations (docs/self-hosting.md, "Sending
# mail from your server"). Pick one provider: smtp, sendgrid or twilio.
# Each secret also accepts a _FILE variant (a Docker secret path); the
# direct value wins when both are set. These are the server's defaults: an
# admin can override any field in Settings > Email.
OMB_MAIL_PROVIDER=
OMB_MAIL_FROM=
# the sender's name (Sagax when empty)
OMB_MAIL_FROM_NAME=
# smtp
OMB_SMTP_HOST=
OMB_SMTP_PORT=
OMB_SMTP_SECURE=
OMB_SMTP_USER=
OMB_SMTP_PASSWORD=
# sendgrid
OMB_SENDGRID_API_KEY=
# twilio (Twilio Email API: an API key SID, SK..., and its secret)
OMB_TWILIO_API_KEY_SID=
OMB_TWILIO_API_KEY_SECRET=
