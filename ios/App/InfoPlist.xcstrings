{
  "sourceLanguage": "en",
  "strings": {
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax sends your position once to the bot that asked. Never in the background."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax envoie votre position une seule fois au bot qui l'a demandée. Jamais en arrière-plan."
          }
        }
      }
    },
    "NSContactsUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax searches your contacts for the name a bot asked about and sends only the details it asked for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax cherche dans vos contacts le nom demandé par un bot et n'envoie que les renseignements demandés."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax reads or adds the reminders a bot asked for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax lit ou ajoute les rappels demandés par un bot."
          }
        }
      }
    },
    "NSRemindersUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax reads or adds the reminders a bot asked for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax lit ou ajoute les rappels demandés par un bot."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax reads your calendar for the days a bot asked about, or adds the event it asked for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax lit votre calendrier pour les jours demandés par un bot, ou ajoute l'événement demandé."
          }
        }
      }
    },
    "NSCalendarsUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax reads your calendar for the days a bot asked about, or adds the event it asked for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax lit votre calendrier pour les jours demandés par un bot, ou ajoute l'événement demandé."
          }
        }
      }
    },
    "NSHomeKitUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax reads the scenes and accessories in your home, or runs the one scene a bot asked for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax lit les scènes et les accessoires de votre maison, ou lance la scène demandée par un bot."
          }
        }
      }
    },
    "NSAlarmKitUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax reads your alarms or adds the one alarm a bot asked for."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax lit vos alarmes ou ajoute l'alarme demandée par un bot."
          }
        }
      }
    },
    "NSFocusStatusUsageDescription": {
      "comment": "Phone tools (Features/PhoneTools): iOS permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you allow it on your phone, Sagax tells the bot that asked whether a Focus is on, so it can wait before disturbing you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous l'autorisez sur votre téléphone, Sagax indique au bot qui l'a demandé si un mode de concentration est actif, pour qu'il attende avant de vous déranger."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Pairing: iOS local network permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax finds your computer on this network so your bots can reach you here."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax trouve votre ordinateur sur ce réseau pour que vos bots puissent vous joindre ici."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Pairing QR code, profile photo, photo for a bot, payment card scan (CardPhotoScanner): iOS camera permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax uses the camera to scan a pairing QR code shown on your computer and, when you choose it, to take your profile photo, a photo to send to a bot, or a photo of a payment card you choose to save."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax utilise l'appareil photo pour lire le code QR de jumelage affiché sur votre ordinateur et, quand vous le choisissez, pour prendre votre photo de profil, une photo à envoyer à un bot ou une photo d'une carte de paiement que vous choisissez d'enregistrer."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Dictation, voice notes, calls: iOS microphone permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax listens while you dictate a message to a bot, record a voice note for one, or talk with one on a call."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax écoute pendant que vous dictez un message à un bot, enregistrez une note vocale pour lui ou lui parlez pendant un appel."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Vault reveal (VaultRevealGate): iOS Face ID permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax uses Face ID to show a card number or another secret you saved. The bot never sees it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax utilise Face ID pour afficher un numéro de carte ou un autre secret que vous avez enregistré. Le bot ne le voit jamais."
          }
        }
      }
    },
    "NSSiriUsageDescription": {
      "comment": "Siri: send a message to a bot or call one, also in the car",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri sends your message to a bot or calls one when you ask, also in the car."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Siri envoie votre message à un bot ou l'appelle quand vous le demandez, aussi en voiture."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Dictation: iOS speech recognition permission prompt",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax converts your speech into text so you can send it to a bot. Recognition runs on this phone when it can."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagax convertit votre voix en texte pour que vous puissiez l'envoyer à un bot. La reconnaissance se fait sur ce téléphone quand c'est possible."
          }
        }
      }
    }
  },
  "version": "1.0"
}
