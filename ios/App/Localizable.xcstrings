          }
        }
      }
    },
    "This routine can't run: it uses its owner's credentials, and there is no %@ subscription, key or organization key for it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This routine can't run: it uses its owner's credentials, and there is no %@ subscription, key or organization key for it."
