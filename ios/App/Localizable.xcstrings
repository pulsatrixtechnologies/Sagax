    "No %@ access for this turn: the person who spoke needs their own subscription or key, or the organization's key.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ access for this turn: the person who spoke needs their own subscription or key, or the organization's key."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun accès %@ pour ce tour : la personne qui a parlé doit avoir son propre abonnement ou sa clé, ou la clé de l'organisation doit être configurée."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem acesso ao %@ nesta vez: quem falou precisa da própria assinatura ou chave, ou da chave da organização."
          }
        }
      }
    },
    "This routine can't run: it uses its owner's credentials, and there is no %@ subscription, key or organization key for it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This routine can't run: it uses its owner's credentials, and there is no %@ subscription, key or organization key for it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette routine ne peut pas s'exécuter : elle utilise les identifiants de son propriétaire, et aucun abonnement %@, aucune clé ni clé d'organisation ne la sert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rotina não pode rodar: ela usa as credenciais do dono, e não há assinatura, chave ou chave da organização do %@ para ela."
          }
        }
      }
    },
    "A key in Settings > Connections serves as the organization's key.": {
      "localizations": {
        "en": {
