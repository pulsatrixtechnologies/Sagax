    "Off stops memory prompts, recall, native memory tools, upkeep, and automatic turn logs. Existing files remain available for review. Stop this bot's turn before changing this setting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off stops memory prompts, recall, native memory tools, upkeep, and automatic turn logs. Existing files remain available for review. Stop this bot's turn before changing this setting."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivée, la mémoire n'envoie plus de rappels, de souvenirs, d'outils de mémoire natifs, d'entretien ni de journaux de tour automatiques. Les fichiers existants restent consultables. Arrêtez le tour de ce bot avant de changer ce réglage."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desligada, a memória deixa de enviar lembretes, recordações, ferramentas de memória nativas, manutenção e registros automáticos de turno. Os arquivos existentes continuam disponíveis para revisão. Pare o turno deste bot antes de mudar este ajuste."
          }
        }
      }
    },
    "Notes this bot keeps between tasks. They are plain markdown files in a folder on this computer — open them in any editor, or in Obsidian.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes this bot keeps between tasks. They are plain markdown files in a folder on this computer — open them in any editor, or in Obsidian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notes que ce bot garde d'une tâche à l'autre. Ce sont de simples fichiers markdown dans un dossier de cet ordinateur — ouvrez-les dans n'importe quel éditeur, ou dans Obsidian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notas que este bot guarda entre tarefas. São arquivos markdown simples em uma pasta deste computador — abra-os em qualquer editor ou no Obsidian."
          }
        }
      }
