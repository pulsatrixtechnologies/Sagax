    "Connected apps run through your own Composio project, so your accounts and tokens stay in a project you control.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected apps run through your own Composio project, so your accounts and tokens stay in a project you control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps connectées passent par votre propre projet Composio : vos comptes et vos tokens restent dans un projet que vous contrôlez."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
