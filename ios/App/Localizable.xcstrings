    "Larger faces, with each bot’s latest message under its name.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Larger faces, with each bot’s latest message under its name."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Visages plus grands, avec le dernier message de chaque bot sous son nom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rostos maiores, com a última mensagem de cada bot abaixo do nome."
          }
        }
      }
    },
    "One line per bot. Bots with more than one active thread show how many; tap the number to list them.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One line per bot. Bots with more than one active thread show how many; tap the number to list them."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne par bot. Les bots qui ont plus d'un fil actif en indiquent le nombre; touchez le nombre pour les afficher."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha por bot. Bots com mais de uma thread ativa mostram quantas têm; toque no número para listá-las."
