    "System follows the phone; Dark keeps Sagax dark. Black is the deepest background, Dim a softer grey.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System follows the phone; Dark keeps Sagax dark. Black is the deepest background, Dim a softer grey."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Système suit le téléphone; Sombre garde Sagax en mode sombre. Noir est le fond le plus foncé, Tamisé un gris plus doux."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistema segue o telefone; Escuro mantém a Sagax escura. Preto é o fundo mais profundo, Suave um cinza mais leve."
          }
        }
      }
    },
    "Changes the language inside Sagax. Buttons drawn by iOS itself follow the phone's language.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes the language inside Sagax. Buttons drawn by iOS itself follow the phone's language."
