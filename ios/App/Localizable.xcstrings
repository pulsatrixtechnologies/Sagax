    },
    "A password-protected backup of this installation: bots, conversations, instructions, local files, and non-secret settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A password-protected backup of this installation: bots, conversations, instructions, local files, and non-secret settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde protégée par mot de passe de cette installation : bots, conversations, instructions, fichiers locaux et réglages non secrets."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um backup protegido por senha desta instalação: bots, conversas, instruções, arquivos locais e ajustes não secretos."
          }
        }
      }
    },
    "Saved account credentials and connections are not included. Reconnect your accounts on a new machine; existing credentials on the destination stay unchanged. External CLI sign-ins and remote VM disks are not included.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved account credentials and connections are not included. Reconnect your accounts on a new machine; existing credentials on the destination stay unchanged. External CLI sign-ins and remote VM disks are not included."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les identifiants de comptes et les connexions ne sont pas inclus. Reconnectez vos comptes sur une nouvelle machine; les identifiants déjà présents à destination ne changent pas. Les connexions des CLI externes et les disques de VM distantes ne sont pas inclus."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Credenciais de contas e conexões não são incluídas. Reconecte suas contas em uma nova máquina; as credenciais já existentes no destino não mudam. Logins de CLIs externas e discos de VMs remotas não são incluídos."
          }
        }
      }
    },
    "Chats, drafts, and user files are not automatically redacted and may contain pasted secrets. Keep this backup private and save its password safely; it cannot be recovered.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chats, drafts, and user files are not automatically redacted and may contain pasted secrets. Keep this backup private and save its password safely; it cannot be recovered."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conversations, brouillons et fichiers ne sont pas caviardés automatiquement et peuvent contenir des secrets collés. Gardez cette sauvegarde privée et conservez son mot de passe en lieu sûr : il est irrécupérable."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversas, rascunhos e arquivos não são ocultados automaticamente e podem conter segredos colados. Mantenha este backup privado e guarde a senha com segurança; ela não pode ser recuperada."
          }
        }
      }
    },
