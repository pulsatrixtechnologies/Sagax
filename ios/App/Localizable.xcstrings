    "Shared keeps the original single-desktop behavior. Per bot gives each bot its own container, folder, viewer port, lease, and idle timer.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared keeps the original single-desktop behavior. Per bot gives each bot its own container, folder, viewer port, lease, and idle timer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagée garde le bureau unique d'origine. Par bot donne à chaque bot son conteneur, son dossier, son port de visualisation, son bail et son délai d'inactivité."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhada mantém o desktop único original. Por bot dá a cada bot seu contêiner, pasta, porta de visualização, reserva e tempo de inatividade."
          }
        }
      }
    },
