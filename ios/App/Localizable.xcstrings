    "Signed in, but this phone couldn't keep the session securely (%@). Builds without signing can't save it; use a signed build.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed in, but this phone couldn't keep the session securely (%@). Builds without signing can't save it; use a signed build."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais ce téléphone n'a pas pu garder la session de façon sécurisée (%@). Une version non signée ne peut pas l'enregistrer; utilisez une version signée."
          }
        }
      }
    },
    "The sign-in expired before the phone could use it. Sign in again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in expired before the phone could use it. Sign in again."
