    "%@ belongs to %@. Its work stops, then the bot, its conversations and its routines are deleted. This is recorded in the activity log and %@ is told. This cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ belongs to %@. Its work stops, then the bot, its conversations and its routines are deleted. This is recorded in the activity log and %@ is told. This cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ appartient à %2$@. Son travail s'arrête, puis le bot, ses conversations et ses routines sont supprimés. L'action est inscrite au journal d'activité et %3$@ en est avisé. C'est irréversible."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ pertence a %2$@. O trabalho para, depois o bot, as conversas e as rotinas são excluídos. Isso fica no registro de atividade e %3$@ é avisado. Não dá para desfazer."
          }
        }
      }
    },
    "%@ stopped. Its owner was told.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stopped. Its owner was told."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est arrêté. Son propriétaire a été avisé."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi parado. O dono foi avisado."
          }
        }
      }
    },
    "%@ deleted. Its owner was told.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deleted. Its owner was told."
