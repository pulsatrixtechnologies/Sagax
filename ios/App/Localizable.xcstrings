    "Keep one scheduled run waiting until this routine finishes. Skip further occurrences until it starts. Manual runs are separate.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep one scheduled run waiting until this routine finishes. Skip further occurrences until it starts. Manual runs are separate."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder une exécution planifiée en attente jusqu’à la fin de cette routine. Les occurrences suivantes sont sautées jusqu’à son début. Les exécutions manuelles sont à part."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter uma execução agendada aguardando até esta rotina terminar. As ocorrências seguintes são puladas até ela começar. Execuções manuais são separadas."
          }
        }
      }
    },
