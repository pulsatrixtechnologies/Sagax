    "Clock changes: skipped times shift forward; repeated times run once.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock changes: skipped times shift forward; repeated times run once."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changements d’heure : une heure sautée est décalée vers l’avant; une heure répétée ne s’exécute qu’une fois."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mudanças de horário: horários pulados avançam; horários repetidos rodam uma vez."
          }
        }
      }
    },
