        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chave em Ajustes > Conexões serve como chave da organização."
          }
        }
      }
    },
    "You don't have %@ access for this message: connect your %@ subscription or add your key in Perspicax.": {
