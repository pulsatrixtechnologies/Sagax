          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connecteurs de votre propre compte claude.ai servent vos bots Claude quand ils roulent sur votre abonnement Claude. Ils agissent en votre nom, avec vos accès."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os conectores da sua própria conta claude.ai chegam aos seus bots Claude quando eles rodam na sua assinatura Claude. Eles agem como você, com o seu acesso."
