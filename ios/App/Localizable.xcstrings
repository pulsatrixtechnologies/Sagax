    "Moves your Bots' shared computer to the latest version. Files and logins stay, but installed apps and packages are removed.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves your Bots' shared computer to the latest version. Files and logins stay, but installed apps and packages are removed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe l'ordinateur partagé de vos bots à la dernière version. Les fichiers et les connexions restent, mais les apps et les paquets installés sont retirés."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualiza o computador compartilhado dos seus bots para a versão mais recente. Arquivos e logins permanecem, mas apps e pacotes instalados são removidos."
          }
        }
      }
    },
    "Rebuild from the current image. Files in your workspace folder stay.": {
