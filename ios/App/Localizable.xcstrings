        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette routine ne peut pas s'exécuter : elle utilise les identifiants de son propriétaire, et aucun abonnement %@, aucune clé ni clé d'organisation ne la sert."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rotina não pode rodar: ela usa as credenciais do dono, e não há assinatura, chave ou chave da organização do %@ para ela."
