    },
    "Run a routine in the chat it reports to, as ordinary messages. Off by default: the work stays in a hidden thread, and the chat only gets the status card.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run a routine in the chat it reports to, as ordinary messages. Off by default: the work stays in a hidden thread, and the chat only gets the status card."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter une routine dans la conversation où elle rend compte, en messages ordinaires. Désactivé par défaut : le travail reste dans un fil caché et la conversation ne reçoit que la carte d'état."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar uma rotina no chat ao qual ela reporta, como mensagens comuns. Desativado por padrão: o trabalho fica em uma conversa oculta e o chat recebe só o cartão de status."
          }
        }
      }
    },
