#!/bin/sh
# Runs before every push: the local merge gate, scripts/verify-merge.mjs
# (`pnpm verify:merge`). No CI runs on a private PR, so this is the barrier:
# lint, typecheck, locale catalogs, source terms, skin contrast, the guard
# tests that break main silently (ratchets, goldens, source scans), the
# tests beside the files of the diff, and iOS when ios/ or shared/ changed.
# A few minutes. The full suite is deliberately NOT here: it runs once, at
# the version cut.
#
# Installed by `pnpm install` through scripts/install-git-hooks.mjs (sets
# core.hooksPath). Skip once with `git push --no-verify`, or for a session
# with SAGAX_SKIP_HOOKS=1.
set -e
# (the old name, OMB_SKIP_HOOKS, still works for one release)
if [ -n "$SAGAX_SKIP_HOOKS$OMB_SKIP_HOOKS" ]; then
  echo "pre-push: skipped (SAGAX_SKIP_HOOKS is set)"
  exit 0
fi
cd "$(git rev-parse --show-toplevel)"
echo "pre-push: pnpm verify:merge (git push --no-verify to skip)"
pnpm verify:merge
